@startuml Cas_Utilisation_Assistant_IA

'=============================================================================
'  MAINTEO — DIAGRAMME DE CAS D'UTILISATION : ASSISTANT IA
'  Conforme au code réel (AiAssistantController, GeminiService, AiConversation, AiMessage)
'  Disposition : 3 par ligne, lecture stricte de gauche à droite, sans parenthèses
'=============================================================================

skinparam packageStyle rectangle
hide stereotype

'------------------------------- Mise en forme -------------------------------
skinparam backgroundColor  #FCFCFE
skinparam shadowing        false
skinparam defaultFontName  Helvetica
skinparam defaultFontSize  12
skinparam roundCorner      10
skinparam nodesep          35
skinparam ranksep          45
skinparam actorStyle       awesome
skinparam ArrowThickness   1.1
skinparam ArrowFontSize    10
skinparam ArrowFontColor   #6B7280

skinparam title {
  FontSize        22
  FontStyle       bold
  FontColor       #1B2A4A
  BorderColor     transparent
  BackgroundColor transparent
}

skinparam actor {
  FontStyle       bold
  FontSize        13
  FontColor       #1B2A4A
  BorderThickness 1.5
  BorderColor<<adm>>  #2F4F8F
  BorderColor<<sso>>  #0E7C6B
  BorderColor<<tec>>  #B03A2E
  BorderColor<<scl>>  #B26B00
  BorderColor<<dem>>  #7D3C98
  BorderColor<<ext>>  #475569
  BackgroundColor<<adm>> #D8E3F6
  BackgroundColor<<sso>> #D2EDE6
  BackgroundColor<<tec>> #F7DAD5
  BackgroundColor<<scl>> #F7E5C9
  BackgroundColor<<dem>> #E8D9F2
  BackgroundColor<<ext>> #E2E8F0
}

skinparam usecase {
  FontSize        11
  FontColor       #2C3A4E
  BorderThickness 1.2
  BackgroundColor #FFFFFF
  BorderColor     #7B5EA7
}

skinparam rectangle {
  FontStyle       bold
  FontSize        13
  BorderThickness 1.6
  BorderStyle     dashed
  BackgroundColor #F9F7FC
  BorderColor     #7B5EA7
  FontColor       #5F4685
}

title MAINTEO — Assistant IA et Aide à la décision

'---------------------------------- Acteurs ----------------------------------
actor "Technicien"               as TECHNICIEN   <<tec>>
actor "Demandeur"                as DEMANDEUR    <<dem>>
actor "Superviseur\nClient"      as SUP_CLIENT   <<scl>>
actor "Superviseur\nSoutarah"    as SUP_SOUTARAH <<sso>>
actor "Administrateur\nSoutarah" as ADMIN        <<adm>>
actor "Service IA Externe"       as EXT_AI       <<ext>>

'============================ DOMAINE FONCTIONNEL ============================

rectangle "ASSISTANCE IA ET AIDE À LA DÉCISION" {

  ' --- LIGNE 1 : Échanges et Diagnostic technique ---
  together {
    usecase "Poser une question à l'assistant"          as UC1
    usecase "Demander une aide au diagnostic de panne"  as UC2
    usecase "Consulter les réponses et recommandations" as UC3
  }
  UC1 -[hidden]right-> UC2
  UC2 -[hidden]right-> UC3

  ' --- LIGNE 2 : Historique et Traitement du modèle ---
  together {
    usecase "Consulter la liste de ses discussions"     as UC4
    usecase "Supprimer une discussion"                  as UC5
    usecase "Générer la réponse par le modèle IA"       as UC6
  }
  UC4 -[hidden]right-> UC5
  UC5 -[hidden]right-> UC6

  ' Alignement vertical strict des 3 colonnes (haut -> bas)
  UC1 -[hidden]down-> UC4
  UC2 -[hidden]down-> UC5
  UC3 -[hidden]down-> UC6

}

'============= ASSOCIATIONS — TERRAIN ET CLIENT (À GAUCHE) ====================
TECHNICIEN -[#B03A2E]-> UC1
TECHNICIEN -[#B03A2E]-> UC2
TECHNICIEN -[#B03A2E]-> UC4

DEMANDEUR -[#7D3C98]-> UC1
DEMANDEUR -[#7D3C98]-> UC4

SUP_CLIENT -[#B26B00]-> UC1
SUP_CLIENT -[#B26B00]-> UC4
SUP_CLIENT -[#B26B00]-> UC5

'============= ASSOCIATIONS — SOUTARAH (À DROITE) ============================
UC1 <-[#0E7C6B]- SUP_SOUTARAH
UC2 <-[#0E7C6B]- SUP_SOUTARAH
UC4 <-[#0E7C6B]- SUP_SOUTARAH
UC5 <-[#0E7C6B]- SUP_SOUTARAH

UC1 <-[#2F4F8F]- ADMIN
UC4 <-[#2F4F8F]- ADMIN
UC5 <-[#2F4F8F]- ADMIN

'============= ASSOCIATIONS — SERVICE IA EXTERNE (EN BAS) ====================
UC6 -[#475569]-> EXT_AI

'============================ RELATIONS UML ==================================
UC2 .[#8C97A8].> UC1 : <<extend>>
UC1 .[#8C97A8].> UC6 : <<include>>
UC6 .[#8C97A8].> UC3 : <<include>>

'=================================== LÉGENDE ================================
legend bottom right
<b>Code couleur des acteurs</b>
<color:#B03A2E>▬▬</color>  Technicien
<color:#7D3C98>▬▬</color>  Demandeur (Client)
<color:#B26B00>▬▬</color>  Superviseur Client
<color:#0E7C6B>▬▬</color>  Superviseur Soutarah
<color:#2F4F8F>▬▬</color>  Administrateur Soutarah
<color:#475569>▬▬</color>  Service IA Externe
<color:#8C97A8>┈┈</color>  Relations «include» / «extend»
endlegend

@enduml
