@startuml Module4_Assistant_IA_Decision

'=============================================================================
'  MAINTEO — DIAGRAMME DE CLASSES : ASSISTANT IA & DÉCISION (MODULE 4)
'  Classes métier : User, AiConversation, AiMessage, RoleMessage
'=============================================================================

hide circle
skinparam packageStyle rectangle
skinparam backgroundColor #FCFCFE
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam defaultFontColor #1B2A4A
skinparam roundCorner 8
skinparam classAttributeIconSize 0
skinparam nodesep 65
skinparam ranksep 50
skinparam linetype ortho

skinparam title {
  FontSize 18
  FontStyle bold
  FontColor #1B2A4A
  BorderColor transparent
  BackgroundColor transparent
}

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #7B5EA7
  BorderThickness 1.3
  HeaderBackgroundColor #F4EFFB
  FontName Helvetica
  FontSize 11
  FontStyle bold
  FontColor #1B2A4A
  AttributeFontName Helvetica
  AttributeFontSize 10
  AttributeFontColor #2C3E50
}

skinparam ArrowColor #4B5563
skinparam ArrowThickness 1.2
skinparam ArrowFontName Helvetica
skinparam ArrowFontSize 10
skinparam ArrowFontColor #374151

title MAINTEO — Module 4 : Assistant IA et Aide à la Décision

' ═════════════════════════════════════════════════════════════════════════════
' LIGNE 1 : L'Utilisateur Connecté
' ═════════════════════════════════════════════════════════════════════════════

class User {
    +id : int
    +nom : string
    +prenom : string
    +email : string
    +type_utilisateur : string
    +telephone : string
    --
    +isAdmin() : boolean
    +isSuperviseurClient() : boolean
    +isTechnicien() : boolean
    +isDemandeur() : boolean
    +getNomComplet() : string
    +consulterHistoriqueIA() : array
}

' ═════════════════════════════════════════════════════════════════════════════
' LIGNE 2 : La Table des Conversations
' ═════════════════════════════════════════════════════════════════════════════

class AiConversation {
    +id : int
    +user_id : int
    +titre : string
    +created_at : datetime
    +updated_at : datetime
    --
    +recupererMessages() : array
    +recupererDernierMessage() : AiMessage
    +renommerDiscussion(titre : string) : void
    +supprimerDiscussion() : boolean
}

' ═════════════════════════════════════════════════════════════════════════════
' LIGNE 3 : La Table des Messages & Énumération des Rôles
' ═════════════════════════════════════════════════════════════════════════════

class AiMessage {
    +id : int
    +conversation_id : int
    +user_id : int
    +role : RoleMessage
    +content : text
    +created_at : datetime
    +updated_at : datetime
    --
    +estMessageUtilisateur() : boolean
    +estReponseAssistant() : boolean
}

class "«enumeration»\nRoleMessage" as RoleMessage {
    user
    assistant
    system
}

' ─────────────────────────────────────────────────────────────────────────────
' DISPOSITION DES BLOCS
' ─────────────────────────────────────────────────────────────────────────────
User -[hidden]down- AiConversation
AiConversation -[hidden]down- AiMessage
AiMessage -[hidden]right- RoleMessage

' ─────────────────────────────────────────────────────────────────────────────
' ASSOCIATIONS ET CARDINALITÉS MÉTIER VÉRIFIÉES
' ─────────────────────────────────────────────────────────────────────────────

' 1. Un utilisateur initie zéro ou plusieurs conversations
User "1" -- "0..*" AiConversation : initier >

' 2. Une conversation contient un ou plusieurs messages
AiConversation "1" -- "1..*" AiMessage : comprendre >

' 3. Un utilisateur expédie zéro ou plusieurs messages
User "1" -- "0..*" AiMessage : expédier >

' 4. Chaque message possède un rôle précis
AiMessage .. RoleMessage : être typé par >

@enduml