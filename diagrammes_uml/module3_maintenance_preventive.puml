@startuml Module3_Maintenance_Preventive

'=============================================================================
'  MAINTEO — DIAGRAMME DE CLASSES : MAINTENANCE PRÉVENTIVE (MODULE 3)
'  Classes métier : User, Site, Maintenance, Equipe, CompteRenduJournalier,
'  StatutMaintenance
'=============================================================================

hide circle
skinparam packageStyle rectangle
skinparam backgroundColor #FCFCFE
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam defaultFontColor #1B2A4A
skinparam roundCorner 8
skinparam classAttributeIconSize 0
skinparam nodesep 65
skinparam ranksep 50
skinparam linetype ortho

skinparam title {
  FontSize 18
  FontStyle bold
  FontColor #1B2A4A
  BorderColor transparent
  BackgroundColor transparent
}

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #0E7C6B
  BorderThickness 1.3
  HeaderBackgroundColor #EBF7F4
  FontName Helvetica
  FontSize 11
  FontStyle bold
  FontColor #1B2A4A
  AttributeFontName Helvetica
  AttributeFontSize 10
  AttributeFontColor #2C3E50
}

skinparam ArrowColor #4B5563
skinparam ArrowThickness 1.2
skinparam ArrowFontName Helvetica
skinparam ArrowFontSize 10
skinparam ArrowFontColor #374151

title MAINTEO — Module 3 : Gestion de la Maintenance Préventive

' ═════════════════════════════════════════════════════════════════════════════
' LIGNE 1 : Responsable & Site d'Intervention
' ═════════════════════════════════════════════════════════════════════════════

class User {
    +id : int
    +nom : string
    +prenom : string
    +type_utilisateur : string
    --
    +planifierMaintenance() : void
}

class Site {
    +id : int
    +nom_site : string
    +code_site : string
    +ville : string
    --
    +listerEquipements() : array
}

' ═════════════════════════════════════════════════════════════════════════════
' LIGNE 2 : Campagne de Maintenance & Équipe Mobilisée
' ═════════════════════════════════════════════════════════════════════════════

class Maintenance {
    +id : int
    +numero_maintenance : string
    +type_maintenance : string
    +description : text
    +taches_prevues : text
    +pieces_prevues : text
    +date_debut_prevue : datetime
    +date_fin_prevue : datetime
    +duree_estimee_heures : decimal
    +statut : string
    +date_debut_reelle : datetime
    +date_fin_reelle : datetime
    +rapport_technicien : text
    +nombre_equipements_prevus : int
    +nombre_equipements_traites : int
    --
    +creerCampagne() : void
    +affecterEquipes() : void
    +calculerAvancement() : float
    +cloturerMaintenance() : void
    +genererRapportFinal() : void
}

class Equipe {
    +id : int
    +nom_equipe : string
    +chef_equipe : int
    --
    +ajouterMembre() : void
    +retirerMembre() : void
}

' ═════════════════════════════════════════════════════════════════════════════
' LIGNE 3 : Suivi Journalier de Chantier & Statuts
' ═════════════════════════════════════════════════════════════════════════════

class CompteRenduJournalier {
    +id : int
    +date_rapport : date
    +noms_intervenants : text
    +activites_realisees : text
    +nombre_equipements_traites : int
    +anomalies_constatees : text
    +difficultes_rencontrees : text
    +materiel_utilise : text
    +heure_fin : time
    +nom_responsable : string
    --
    +saisirCompteRendu() : void
    +mettreAJourAvancement() : void
    +signerFeuilleJournee() : void
}

class "«enumeration»\nStatutMaintenance" as StatutMaintenance {
    PLANIFIEE
    CONFIRMEE_CLIENT
    EN_COURS
    TERMINEE
    VALIDEE_CLIENT
    ANNULEE
}

' ─────────────────────────────────────────────────────────────────────────────
' DISPOSITION DES BLOCS
' ─────────────────────────────────────────────────────────────────────────────
User -[hidden]right- Site
Maintenance -[hidden]right- Equipe
CompteRenduJournalier -[hidden]right- StatutMaintenance

User -[hidden]down- Maintenance
Site -[hidden]down- Equipe
Maintenance -[hidden]down- CompteRenduJournalier
Equipe -[hidden]down- StatutMaintenance

' ─────────────────────────────────────────────────────────────────────────────
' ASSOCIATIONS ET CARDINALITÉS MÉTIER VÉRIFIÉES
' ─────────────────────────────────────────────────────────────────────────────

' Planification par le superviseur
User "1" -down- "0..*" Maintenance : planifier >

' Localisation de la maintenance
Maintenance "0..*" -up- "1" Site : cibler >

' Mobilisation des équipes sur la maintenance
Maintenance "0..*" -right- "1..*" Equipe : mobiliser >

' Suivi journalier par les comptes rendus
Maintenance "1" -down- "0..*" CompteRenduJournalier : comprendre >

' Rédaction et validation du compte rendu
CompteRenduJournalier "0..*" -- "1" Equipe : être rédigé par >
CompteRenduJournalier "0..*" -- "1" User : être visé par >

@enduml
