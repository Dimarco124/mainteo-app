@startuml Module2_Interventions_Depannages

'=============================================================================
'  MAINTEO — DIAGRAMME DE CLASSES : DÉPANNAGES ET INTERVENTIONS (MODULE 2)
'  Classes métier : User, Equipement, Demande, Depannage, Equipe, Planification,
'  StatutDemande, StatutDepannage
'=============================================================================

hide circle
skinparam packageStyle rectangle
skinparam backgroundColor #FCFCFE
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam defaultFontColor #1B2A4A
skinparam roundCorner 8
skinparam classAttributeIconSize 0
skinparam nodesep 65
skinparam ranksep 50
skinparam linetype ortho

skinparam title {
  FontSize 18
  FontStyle bold
  FontColor #1B2A4A
  BorderColor transparent
  BackgroundColor transparent
}

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #B5813A
  BorderThickness 1.3
  HeaderBackgroundColor #FDF5EB
  FontName Helvetica
  FontSize 11
  FontStyle bold
  FontColor #1B2A4A
  AttributeFontName Helvetica
  AttributeFontSize 10
  AttributeFontColor #2C3E50
}

skinparam ArrowColor #4B5563
skinparam ArrowThickness 1.2
skinparam ArrowFontName Helvetica
skinparam ArrowFontSize 10
skinparam ArrowFontColor #374151

title MAINTEO — Module 2 : Workflow des Demandes, Dépannages et Notifications

' ═════════════════════════════════════════════════════════════════════════════
' LIGNE 1 : Acteur, Équipement & Notifications
' ═════════════════════════════════════════════════════════════════════════════

class User {
    +id : int
    +nom : string
    +prenom : string
    +email : string
    -mot_de_passe : string
    +type_utilisateur : string
    +statut : string
    +telephone : string
    +specialite : string
    --
    +seConnecter() : boolean
    +seDeconnecter() : void
    +isAdmin() : boolean
    +isSuperviseurClient() : boolean
    +isDemandeur() : boolean
    +isTechnicien() : boolean
    +isChefTechnicien() : boolean
    +getNomComplet() : string
}

class Equipement {
    +id : int
    +equipement_code : string
    +equipement_nom : string
    +marque : string
    +type : string
    +emplacement : string
    +etat : string
    --
    +mettreAJourEtat() : void
    +consulterHistorique() : array
}

' ═════════════════════════════════════════════════════════════════════════════
' LIGNE 2 : Demande d'Intervention & Dépannage Technique
' ═════════════════════════════════════════════════════════════════════════════

class Demande {
    +id : int
    +numero_demande : string
    +type_intervention : string
    +description : text
    +niveau_urgence : string
    +date_debut_souhaitee : date
    +photo_panne : string
    +statut : string
    +est_vip : boolean
    +date_validation_client : datetime
    +date_validation_soutarah : datetime
    +date_confirmee_avec_demandeur : date
    +date_cloture_finale : datetime
    --
    +creerDemande() : void
    +validerParClient() : void
    +validerParSoutarah() : void
    +rejeterDemande() : void
    +confirmerRendezVous() : void
    +cloturer() : void
}

class Depannage {
    +id : int
    +type_intervention : string
    +urgence : string
    +statut : string
    +date_prevue : datetime
    +date_debut_prevue : date
    +date_fin_prevue : date
    +date_realisation : datetime
    +rapport_technique : text
    +photos_rapport : json
    +ri_soutarah : string
    +approuve_client : boolean
    +date_rapport_technicien : datetime
    +date_validation_finale_client : datetime
    --
    +affecterTechnicien() : void
    +affecterEquipe() : void
    +soumettreRapport() : void
    +validerRapport() : void
    +signerAttestationClient() : void
}

' ═════════════════════════════════════════════════════════════════════════════
' LIGNE 3 : Équipe Technique & Planification
' ═════════════════════════════════════════════════════════════════════════════

class Equipe {
    +id : int
    +nom_equipe : string
    +chef_equipe : int
    --
    +ajouterMembre() : void
    +retirerMembre() : void
    +designationChef() : void
}

class Planification {
    +id : int
    +site_code : string
    +date_debut : datetime
    +date_fin : datetime
    +statut : string
    +commentaire : text
    --
    +planifierIntervention() : void
    +modifierDate() : void
    +annulerPlanification() : void
}

' ═════════════════════════════════════════════════════════════════════════════
' LIGNE 4 : Énumérations Métier
' ═════════════════════════════════════════════════════════════════════════════

class "«enumeration»\nStatutDemande" as StatutDemande {
    PENDING_CLIENT_VALIDATION
    VALIDATED_BY_CLIENT
    REJECTED_BY_CLIENT
    NEEDS_TECHNICAL_OPERATION
    REJECTED_BY_SOUTARAH
    CONFIRMED_BY_DEMANDEUR
    CLOSED
}

class "«enumeration»\nStatutDepannage" as StatutDepannage {
    EN_ATTENTE
    PLANIFIE
    EN_COURS
    RAPPORT_SOUMIS
    RAPPORT_VALIDE
    CLOTURE
}

' ─────────────────────────────────────────────────────────────────────────────
' DISPOSITION DES BLOCS
' ─────────────────────────────────────────────────────────────────────────────
User -[hidden]right- Equipement

User -[hidden]down- Demande
Equipement -[hidden]down- Depannage

Demande -[hidden]right- Depannage
Demande -[hidden]down- Equipe
Depannage -[hidden]down- Planification

Equipe -[hidden]right- Planification
Equipe -[hidden]down- StatutDemande
Planification -[hidden]down- StatutDepannage

' ─────────────────────────────────────────────────────────────────────────────
' ASSOCIATIONS ET CARDINALITÉS MÉTIER VÉRIFIÉES
' ─────────────────────────────────────────────────────────────────────────────

' Émission et traitement de la demande
User "1" -down- "0..*" Demande : émettre >
Demande "0..*" -- "0..1" Equipement : cibler >
Demande "0..1" -right- "0..1" Depannage : déclencher >

' Réparation et planification
Depannage "0..*" -up- "0..1" Equipement : réparer >
Depannage "1" -down- "0..*" Planification : programmer via >

' Prise en charge par l'équipe
User "1..*" -down- "0..*" Equipe : composer >
Equipe "0..1" -- "0..*" Depannage : prendre en charge >
Equipe "0..1" -right- "0..*" Planification : mobiliser pour >

@enduml
