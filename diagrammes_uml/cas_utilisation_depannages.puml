@startuml Cas_Utilisation_Depannages

'=============================================================================
'  MAINTEO — DIAGRAMME DE CAS D'UTILISATION : DÉPANNAGES
'  Matrice 3 colonnes : lecture stricte de gauche à droite
'=============================================================================

skinparam packageStyle rectangle
hide stereotype

'------------------------------- Mise en forme -------------------------------
skinparam backgroundColor  #FCFCFE
skinparam shadowing        false
skinparam defaultFontName  Helvetica
skinparam defaultFontSize  12
skinparam roundCorner      10
skinparam nodesep          35
skinparam ranksep          45
skinparam actorStyle       awesome
skinparam ArrowThickness   1.1
skinparam ArrowFontSize    10
skinparam ArrowFontColor   #6B7280

skinparam title {
  FontSize        22
  FontStyle       bold
  FontColor       #1B2A4A
  BorderColor     transparent
  BackgroundColor transparent
}

skinparam actor {
  FontStyle       bold
  FontSize        13
  FontColor       #1B2A4A
  BorderThickness 1.5
  BorderColor<<adm>>  #2F4F8F
  BorderColor<<sso>>  #0E7C6B
  BorderColor<<tec>>  #B03A2E
  BorderColor<<scl>>  #B26B00
  BorderColor<<dem>>  #7D3C98
  BackgroundColor<<adm>> #D8E3F6
  BackgroundColor<<sso>> #D2EDE6
  BackgroundColor<<tec>> #F7DAD5
  BackgroundColor<<scl>> #F7E5C9
  BackgroundColor<<dem>> #E8D9F2
}

skinparam usecase {
  FontSize        11
  FontColor       #2C3A4E
  BorderThickness 1.2
  BackgroundColor #FFFFFF
  BorderColor     #B5813A
}

skinparam rectangle {
  FontStyle       bold
  FontSize        13
  BorderThickness 1.6
  BorderStyle     dashed
  BackgroundColor #FDF8F2
  BorderColor     #B5813A
  FontColor       #8F6426
}

title MAINTEO — Gestion des Dépannages

'---------------------------------- Acteurs ----------------------------------
actor "Demandeur"              as DEMANDEUR    <<dem>>
actor "Superviseur\nClient"    as SUP_CLIENT   <<scl>>
actor "Superviseur\nSoutarah"  as SUP_SOUTARAH <<sso>>
actor "Administrateur\nSoutarah" as ADMIN      <<adm>>
actor "Technicien"             as TECHNICIEN   <<tec>>

'============================ DOMAINE FONCTIONNEL ============================

rectangle "GESTION DES DÉPANNAGES" {

  ' --- LIGNE 1 : Demande et Validations initiales ---
  together {
    usecase "Créer une demande de dépannage"       as UC1
    usecase "Valider la demande par le client"     as UC2
    usecase "Valider la prise en charge Soutarah"  as UC3
  }
  UC1 -[hidden]right-> UC2
  UC2 -[hidden]right-> UC3

  ' --- LIGNE 2 : Planification et Intervention terrain ---
  together {
    usecase "Planifier la date et affecter l'équipe" as UC4
    usecase "Réparer la panne sur le terrain"        as UC5
    usecase "Confirmer le passage des techniciens"   as UC6
  }
  UC4 -[hidden]right-> UC5
  UC5 -[hidden]right-> UC6

  ' --- LIGNE 3 : Rapports et Clôture (de gauche à droite) ---
  together {
    usecase "Soumettre le rapport technique"         as UC7
    usecase "Vérifier le rapport d'intervention"     as UC8
    usecase "Valider la clôture du dépannage"        as UC9
  }
  UC7 -[hidden]right-> UC8
  UC8 -[hidden]right-> UC9

  ' Alignement vertical des 3 colonnes (haut -> bas)
  UC1 -[hidden]down-> UC4
  UC4 -[hidden]down-> UC7

  UC2 -[hidden]down-> UC5
  UC5 -[hidden]down-> UC8

  UC3 -[hidden]down-> UC6
  UC6 -[hidden]down-> UC9

}

'============= ASSOCIATIONS — CLIENT (À GAUCHE) ==============================
DEMANDEUR -[#7D3C98]-> UC1
DEMANDEUR -[#7D3C98]-> UC6

SUP_CLIENT -[#B26B00]-> UC1
SUP_CLIENT -[#B26B00]-> UC2
SUP_CLIENT -[#B26B00]-> UC6
SUP_CLIENT -[#B26B00]-> UC9

'============= ASSOCIATIONS — SOUTARAH (À DROITE) ============================
UC3 <-[#0E7C6B]- SUP_SOUTARAH
UC4 <-[#0E7C6B]- SUP_SOUTARAH
UC8 <-[#0E7C6B]- SUP_SOUTARAH

UC3 <-[#2F4F8F]- ADMIN
UC4 <-[#2F4F8F]- ADMIN
UC8 <-[#2F4F8F]- ADMIN

'============= ASSOCIATIONS — TECHNICIEN (EN BAS) ============================
UC5 <-[#B03A2E]- TECHNICIEN
UC7 <-[#B03A2E]- TECHNICIEN

'============================ RELATIONS UML ==================================
UC3 .[#8C97A8].> UC4 : <<include>>
UC8 .[#8C97A8].> UC9 : <<include>>

'=================================== LÉGENDE ================================
legend bottom right
<b>Code couleur des acteurs</b>
<color:#7D3C98>▬▬</color>  Demandeur (Client)
<color:#B26B00>▬▬</color>  Superviseur Client
<color:#0E7C6B>▬▬</color>  Superviseur Soutarah
<color:#2F4F8F>▬▬</color>  Administrateur Soutarah
<color:#B03A2E>▬▬</color>  Technicien
<color:#8C97A8>┈┈</color>  Relations «include»
endlegend

@enduml
